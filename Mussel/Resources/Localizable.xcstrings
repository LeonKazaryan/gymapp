    "A 12-week program from machines to the barbell, and every exercise shown so you know what to do and where." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программа на 12 недель — от тренажёров до штанги. Каждое упражнение показано: что делать, на каком тренажёре и как."
          }
        }
      }
    },
